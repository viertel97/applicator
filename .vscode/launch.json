{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (no-auth / dev user)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "MS_TENANT_ID": "",
        "MS_CLIENT_ID": "",
        "MS_CLIENT_SECRET": ""
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "API (auth / MS OAuth)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Frontend (vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (no-auth)",
      "configurations": ["API (no-auth / dev user)", "Frontend (vite)"]
    },
    {
      "name": "Full stack (auth)",
      "configurations": ["API (auth / MS OAuth)", "Frontend (vite)"]
    }
  ]
}
